    <rdfs:label>Yevr.-Arab. I 1701</rdfs:label>
    <kg:documentType>record of the Karaite court of Cairo (register)</kg:documentType>
    <dcterms:date>7 Tevet 14[..] Sel. (after 1089; c. 1200 [?])</dcterms:date>
    <dcterms:source>PGP 2728 (Goitein transcription, Zinger translation); Zinger 2017, n. 17</dcterms:source>
