  <rdf:Description rdf:about="https://w3id.org/karaite-geniza/ontology#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Karaite Geniza Social Network Ontology</dcterms:title>
    <dcterms:description xml:lang="en">A lightweight prosopographic ontology for Karaite legal documents from the Cairo Geniza. Appearances are modelled as events linking a person, a document and an action from a closed vocabulary, with an explicit evidential certainty.</dcterms:description>
    <dcterms:source xml:lang="en">Olszowy-Schlanger 1998; Zinger 2017</dcterms:source>
  </rdf:Description>
