    <kg:placeCertainty>probable</kg:placeCertainty>
    <rdfs:comment xml:lang="en">three trustees divide the estate of Sahl b. Joseph, who died intestate, among four sons; two minors' shares stay in trust</rdfs:comment>
  </rdf:Description>
