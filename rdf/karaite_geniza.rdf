    <kg:writtenAt rdf:resource="https://w3id.org/karaite-geniza/place/PL02"/>
    <kg:placeCertainty>certain</kg:placeCertainty>
    <rdfs:comment xml:lang="en">inquiry into rumours of harassment of a married woman, convened by the nasi in his sister's house; ban declared next day</rdfs:comment>
  </rdf:Description>
