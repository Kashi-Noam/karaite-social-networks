    <dcterms:date>13 July 1055</dcterms:date>
    <dcterms:source>Zinger 2017</dcterms:source>
    <kg:yearEstimate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1055</kg:yearEstimate>
    <kg:writtenAt rdf:resource="https://w3id.org/karaite-geniza/place/PL01"/>
    <kg:placeCertainty>certain</kg:placeCertainty>
    <rdfs:comment xml:lang="en">Rabbanite judge Eli b. Amram + Rabbanite elders convene at the majlis of the Karaite nasi Josiah b. Solomon; inheritance of the children of Tammam; guarantees against recourse to Muslim courts; three Rabbanite trustees appointed</rdfs:comment>
  </rdf:Description>
