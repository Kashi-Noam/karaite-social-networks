  <rdf:Description rdf:about="https://w3id.org/karaite-geniza/person/P084">
    <rdf:type rdf:resource="https://w3id.org/karaite-geniza/ontology#Person"/>
    <foaf:name>Efraim b. Shemarya</foaf:name>
    <dcterms:identifier>P084</dcterms:identifier>
    <kg:hasSect rdf:resource="https://w3id.org/karaite-geniza/sect/Rabbanite"/>
    <foaf:gender>male</foaf:gender>
    <kg:sectEvidence xml:lang="en">head of the Palestinian congregation in Fustat, d. 1055</kg:sectEvidence>
    <kg:activeFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1030</kg:activeFrom>
    <kg:activeTo rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1062</kg:activeTo>
    <owl:sameAs rdf:resource="https://geniza.princeton.edu/people/efrayim-b-shemarya/"/>
    <kg:externalMatchCertainty>confirmed</kg:externalMatchCertainty>
    <rdfs:comment xml:lang="en">Samuel b. Sahl signed a document of his Rabbanite court together with other Karaites (~1042) | his death in 1055 opened the leadership contest in Fustat; Eli b. Amram succeeded him | his letter of thanks (~1035) names Sahlawaya b. Hayyim among the benefactors | leader of the Palestinians in Fustat; his draft letter TS 13 J 8.14 lists Karaites (incl. Ezra b. Samuel b. Ezra and the 'elders Tustari') who helped the Jerusalem community | recipient of Solomon b. Jehuda's complaints about Nathan b. Abraham's Karaite connections</rdfs:comment>
    <kg:hasAppearance rdf:resource="https://w3id.org/karaite-geniza/appearance/P084_TS_16_50_ACT15_b3898aa1"/>
    <kg:hasAppearance rdf:resource="https://w3id.org/karaite-geniza/appearance/P084_TS_12_621_ACT15_a45a1a13"/>
    <kg:hasAppearance rdf:resource="https://w3id.org/karaite-geniza/appearance/P084_TS_24_13_ACT15_6b26a271"/>
    <kg:hasAppearance rdf:resource="https://w3id.org/karaite-geniza/appearance/P084_ENA_4020_38v_ACT15_df15eeca"/>
    <kg:hasAppearance rdf:resource="https://w3id.org/karaite-geniza/appearance/P084_Mosseri_VII_43_TS_Ar_53_53_ACT15_38a59768"/>
  </rdf:Description>
