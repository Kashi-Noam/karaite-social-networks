    <rdfs:label>TS 16.171 + TS AS 146.459</rdfs:label>
    <kg:documentType>deed of inheritance division (draft)</kg:documentType>
    <dcterms:date>Tammuz 1315 Sel. = June/July 1004</dcterms:date>
    <dcterms:source>PGP 7430 (Krakowski digital edition); ed. Mann, Texts and Studies 2:196-198; Zinger 2017, n. 15</dcterms:source>
    <kg:yearEstimate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1004</kg:yearEstimate>
