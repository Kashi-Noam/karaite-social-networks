  <rdf:Description rdf:about="https://w3id.org/karaite-geniza/person/P302">
    <rdf:type rdf:resource="https://w3id.org/karaite-geniza/ontology#Person"/>
    <foaf:name>Sahlawaya b. Hayyim</foaf:name>
    <dcterms:identifier>P302</dcterms:identifier>
    <kg:hasSect rdf:resource="https://w3id.org/karaite-geniza/sect/Karaite"/>
    <foaf:gender>male</foaf:gender>
    <skos:altLabel xml:lang="en">Sahlawayh b. Hayyim (PGP); ancestor line: Sahlawaya b. Hayyim b. Sahlawaya b. 'Eli b. Sahlawaya b. 'Abda</skos:altLabel>
    <kg:sectEvidence xml:lang="en">rich Karaite banker of Fustat, active 1011-1035 (TS AS 145.307r + TS Misc. 29.58a r, TS 12.621, ENA NS 18.37, ch.3)</kg:sectEvidence>
    <kg:activeFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1035</kg:activeFrom>
    <kg:activeTo rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1038</kg:activeTo>
    <owl:sameAs rdf:resource="https://geniza.princeton.edu/people/sahlawayh-b-hayyim/"/>
    <kg:externalMatchCertainty>confirmed</kg:externalMatchCertainty>
    <rdfs:comment xml:lang="en">prominent Karaite banker of Fustat (active 1011-1035); still alive | the 1011 Aleppo letter is his earliest attestation: fifty dinars of the suftaja were drawn on him in Fustat | the Fustat Karaite banker; ancestor name Abda in signature decoration | the Fustat Karaite banker; father Hayyim already dead here</rdfs:comment>
    <kg:hasAppearance rdf:resource="https://w3id.org/karaite-geniza/appearance/P302_TS_AS_145_307r_TS_Misc_29_58_ACT13_7c3389c6"/>
    <kg:hasAppearance rdf:resource="https://w3id.org/karaite-geniza/appearance/P302_TS_12_621_ACT13_885e89c3"/>
