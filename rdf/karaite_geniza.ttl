@prefix kg:    <https://w3id.org/karaite-geniza/ontology#> .
@prefix kgp:   <https://w3id.org/karaite-geniza/person/> .
@prefix kgl:   <https://w3id.org/karaite-geniza/place/> .
@prefix doc:   <https://w3id.org/karaite-geniza/document/> .
@prefix app:   <https://w3id.org/karaite-geniza/appearance/> .
@prefix act:   <https://w3id.org/karaite-geniza/action/> .
@prefix rel:   <https://w3id.org/karaite-geniza/relation/> .
@prefix sect:  <https://w3id.org/karaite-geniza/sect/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix geo:   <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

### ---------------------------------------------------------------- ontology
kg: a owl:Ontology ;
    dcterms:title "Karaite Geniza Social Network Ontology"@en ;
    dcterms:description "A lightweight prosopographic ontology for Karaite legal documents from the Cairo Geniza. Appearances are modelled as events linking a person, a document and an action from a closed vocabulary, with an explicit evidential certainty."@en ;
    dcterms:source "Olszowy-Schlanger 1998; Zinger 2017"@en .

kg:Person a owl:Class ; rdfs:subClassOf foaf:Person ;
    rdfs:label "Person"@en ; rdfs:label "אדם"@he .
kg:Document a owl:Class ;
    rdfs:label "Geniza document"@en ; rdfs:label "מסמך גניזה"@he .
kg:Place a owl:Class ;
    rdfs:label "Place"@en ; rdfs:label "מקום"@he .
kg:Appearance a owl:Class ;
    rdfs:label "Appearance"@en ; rdfs:label "הופעה"@he ;
    rdfs:comment "The event of a person performing one action in one document."@en .
kg:Action a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Action"@en ; rdfs:label "פעולה"@he .
kg:Sect a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Sect"@en ; rdfs:label "עדה"@he .

kg:hasAppearance   a owl:ObjectProperty ; rdfs:domain kg:Person ; rdfs:range kg:Appearance .
kg:inDocument      a owl:ObjectProperty ; rdfs:domain kg:Appearance ; rdfs:range kg:Document .
kg:performedAction a owl:ObjectProperty ; rdfs:domain kg:Appearance ; rdfs:range kg:Action .
kg:byPerson        a owl:ObjectProperty ; rdfs:domain kg:Appearance ; rdfs:range kg:Person .
kg:certainty       a owl:DatatypeProperty ; rdfs:domain kg:Appearance ;
    rdfs:comment "attested | reconstructed | contextual"@en .
kg:writtenAt       a owl:ObjectProperty ; rdfs:domain kg:Document ; rdfs:range kg:Place .
kg:placeCertainty  a owl:DatatypeProperty ; rdfs:domain kg:Document .
kg:yearEstimate    a owl:DatatypeProperty ; rdfs:domain kg:Document ; rdfs:range xsd:gYear .
kg:documentType    a owl:DatatypeProperty ; rdfs:domain kg:Document .
kg:hasSect         a owl:ObjectProperty ; rdfs:domain kg:Person ; rdfs:range kg:Sect .
kg:sectEvidence    a owl:DatatypeProperty ; rdfs:domain kg:Person .
kg:originPlace     a owl:ObjectProperty ; rdfs:domain kg:Person ; rdfs:range kg:Place .
kg:coAppearsWith   a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain kg:Person ; rdfs:range kg:Person ;
    rdfs:comment "Joint presence in at least one legal act; kg:weight gives the number of shared documents."@en .
kg:weight          a owl:DatatypeProperty ; rdfs:range xsd:integer .
kg:evidence        a owl:DatatypeProperty .
kg:derivation      a owl:DatatypeProperty ;
    rdfs:comment "explicit (stated in the source) | derived_from_roles"@en .

### interpersonal relations (closed vocabulary)
rel:married a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "married"@en ; rdfs:label "בני זוג נשואים"@he .
rel:betrothed a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "betrothed"@en ; rdfs:label "מאורסים"@he .
rel:divorced a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "divorced"@en ; rdfs:label "גרושים"@he .
rel:first_husband_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "first husband of"@en ; rdfs:label "בעל ראשון של"@he .
rel:father_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "father of"@en ; rdfs:label "אב של"@he .
rel:mother_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "mother of"@en ; rdfs:label "אם של"@he .
rel:sibling_of a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "sibling of"@en ; rdfs:label "אח/אחות של"@he .
rel:first_cousin_of a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "first cousin of"@en ; rdfs:label "בן/בת דוד של"@he .
rel:uncle_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "uncle of"@en ; rdfs:label "דוד של"@he .
rel:ancestor_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "ancestor of"@en ; rdfs:label "אב קדמון של (סב ומעלה)"@he .
rel:son_in_law_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "son in law of"@en ; rdfs:label "חתן של"@he .
rel:agent_for a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "agent for"@en ; rdfs:label "שליח של"@he .
rel:gave_gift_to a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "gave gift to"@en ; rdfs:label "העניק מתנה ל"@he .
rel:business_associate_of a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "business associate of"@en ; rdfs:label "שותף עסקי של"@he .
rel:corresponded_with a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "corresponded with"@en ; rdfs:label "התכתב עם"@he .
rel:colleague_of a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "colleague of"@en ; rdfs:label "עמית של"@he .
rel:rival_of a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "rival of"@en ; rdfs:label "יריב של"@he .
rel:patron_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "patron of"@en ; rdfs:label "פטרון של"@he .
rel:teacher_of a owl:ObjectProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "teacher of"@en ; rdfs:label "מורה של"@he .
rel:associated_with a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:subPropertyOf kg:relatedTo ; rdfs:label "associated with"@en ; rdfs:label "קשור אל (קשר מתועד אחר)"@he .
kg:relatedTo a owl:ObjectProperty ; rdfs:label "related to"@en .

### ---------------------------------------------------------------- closed vocabularies
kg:ActionScheme a skos:ConceptScheme ; skos:prefLabel "Document actions"@en .
act:ACT01 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Groom"@en ; skos:prefLabel "חתן"@he ; skos:definition "contracts the betrothal/marriage as husband"@en ; kg:actionClass "Party" .
act:ACT02 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Bride"@en ; skos:prefLabel "כלה"@he ; skos:definition "is betrothed/married; accepts the marriage and its conditions"@en ; kg:actionClass "Party" .
act:ACT03 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "LegalParty"@en ; skos:prefLabel "צד משפטי"@he ; skos:definition "litigant, heir or claimant in a legal proceeding"@en ; kg:actionClass "Party" .
act:ACT04 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Guarantor"@en ; skos:prefLabel "ערב"@he ; skos:definition "stands surety (daman al-darak) for another party"@en ; kg:actionClass "Party" .
act:ACT05 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Agent"@en ; skos:prefLabel "שליח (פקיד)"@he ; skos:definition "represents a party - receives the mohar, contracts on her/his behalf"@en ; kg:actionClass "Representation" .
act:ACT06 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "WitnessOfAgency"@en ; skos:prefLabel "עד מינוי שליח"@he ; skos:definition "witnesses the appointment of the agent"@en ; kg:actionClass "Attestation" .
act:ACT07 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Witness"@en ; skos:prefLabel "עד חותם"@he ; skos:definition "signs the document as witness"@en ; kg:actionClass "Attestation" .
act:ACT08 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Scribe"@en ; skos:prefLabel "סופר"@he ; skos:definition "writes the document"@en ; kg:actionClass "Attestation" .
act:ACT09 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Declarant"@en ; skos:prefLabel "מצהיר בפני בית דין"@he ; skos:definition "declares/confirms before the court (court copies, certifications)"@en ; kg:actionClass "Attestation" .
act:ACT10 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Judge"@en ; skos:prefLabel "דיין / אב בית דין"@he ; skos:definition "presides over the session; examines and certifies deeds"@en ; kg:actionClass "Court" .
act:ACT11 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "Trustee"@en ; skos:prefLabel "נאמן בית דין"@he ; skos:definition "court-appointed trustee over property"@en ; kg:actionClass "Court" .
act:ACT12 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "NamedNasi"@en ; skos:prefLabel "נשיא מכהן"@he ; skos:definition "the reigning nasi named in the dating clause"@en ; kg:actionClass "Reference" .
act:ACT13 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "FamilyMention"@en ; skos:prefLabel "נזכר כבן משפחה"@he ; skos:definition "parent/grandparent named in a party's genealogy"@en ; kg:actionClass "Reference" .
act:ACT14 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "DocumentMention"@en ; skos:prefLabel "נזכר במסמך"@he ; skos:definition "any other person named in the document text"@en ; kg:actionClass "Reference" .
act:ACT15 a kg:Action ; skos:inScheme kg:ActionScheme ; skos:prefLabel "ScholarlyMention"@en ; skos:prefLabel "נזכר בהערות המהדיר"@he ; skos:definition "person known only from the editors' commentary/footnotes on this document"@en ; kg:actionClass "Reference" .

kg:SectScheme a skos:ConceptScheme ; skos:prefLabel "Sect identifications"@en .
sect:Karaite a kg:Sect ; skos:inScheme kg:SectScheme ; skos:prefLabel "Karaite"@en .
sect:Karaite_probable a kg:Sect ; skos:inScheme kg:SectScheme ; skos:prefLabel "Karaite (probable)"@en .
sect:Karaite_presumed a kg:Sect ; skos:inScheme kg:SectScheme ; skos:prefLabel "Karaite (presumed)"@en .
sect:Rabbanite a kg:Sect ; skos:inScheme kg:SectScheme ; skos:prefLabel "Rabbanite"@en .
sect:Rabbanite_probable a kg:Sect ; skos:inScheme kg:SectScheme ; skos:prefLabel "Rabbanite (probable)"@en .
sect:unknown a kg:Sect ; skos:inScheme kg:SectScheme ; skos:prefLabel "unknown"@en .

